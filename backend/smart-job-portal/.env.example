# Backend Environment Variables
# Copy this file and set values as Windows environment variables
# or pass them via: set VAR=value && mvn spring-boot:run

# Database
DB_URL=jdbc:mysql://localhost:3306/smart_job_portal?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT (use a long random string, min 32 chars)
JWT_SECRET=YourSuperSecretJWTKeyThatIsAtLeast32CharactersLong2024
JWT_EXPIRATION=86400000

# File Upload Directory (absolute path recommended on Windows)
UPLOAD_DIR=./uploads

# CORS - Frontend origin
CORS_ORIGIN=http://localhost:5173
